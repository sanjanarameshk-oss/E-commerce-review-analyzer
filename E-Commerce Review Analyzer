l,"_view_module":"@jupyter-widgets/base","_view_module_version":"1.2.0","_view_name":"StyleView","description_width":""}}}}}},"cells":[{"cell_type":"code","source":["# ============================================================\n","# E-COMMERCE REVIEW ANALYZER WEB APPLICATION\n","# Google Colab - Single Cell\n","# ============================================================\n","\n","!pip -q install gradio transformers torch\n","\n","import gradio as gr\n","from transformers import pipeline\n","from collections import Counter\n","import re\n","\n","# ============================================================\n","# LOAD AI SENTIMENT MODEL\n","# ============================================================\n","\n","sentiment_model = pipeline(\n","    \"sentiment-analysis\"\n",")\n","\n","# ============================================================\n","# PRODUCT KEYWORDS\n","# ============================================================\n","\n","product_keywords = {\n","    \"Quality\": [\n","        \"quality\", \"good quality\", \"poor quality\",\n","        \"durable\", \"strong\", \"weak\"\n","    ],\n","\n","    \"Price\": [\n","        \"price\", \"expensive\", \"cheap\",\n","        \"cost\", \"value\", \"worth\"\n","    ],\n","\n","    \"Delivery\": [\n","        \"delivery\", \"delivered\", \"shipping\",\n","        \"late\", \"fast delivery\", \"delay\"\n","    ],\n","\n","    \"Packaging\": [\n","        \"packaging\", \"package\", \"box\",\n","        \"packed\", \"packing\"\n","    ],\n","\n","    \"Size\": [\n","        \"size\", \"small\", \"large\", \"fit\",\n","        \"fitting\"\n","    ],\n","\n","    \"Product\": [\n","        \"product\", \"item\", \"product quality\"\n","    ],\n","\n","    \"Service\": [\n","        \"service\", \"customer service\",\n","        \"support\", \"seller\"\n","    ],\n","\n","    \"Battery\": [\n","        \"battery\", \"charging\", \"charge\",\n","        \"battery life\"\n","    ],\n","\n","    \"Design\": [\n","        \"design\", \"look\", \"appearance\",\n","        \"color\", \"beautiful\"\n","    ]\n","}\n","\n","# ============================================================\n","# ANALYZE REVIEW\n","# ============================================================\n","\n","def analyze_review(review):\n","\n","    if review is None or review.strip() == \"\":\n","        return \"⚠️ Please enter a product review.\"\n","\n","    text = review.lower()\n","\n","    # --------------------------------------------------------\n","    # SENTIMENT ANALYSIS\n","    # --------------------------------------------------------\n","\n","    try:\n","\n","        result = sentiment_model(review)[0]\n","\n","        sentiment = result[\"label\"]\n","\n","        confidence = round(\n","            result[\"score\"] * 100,\n","            2\n","        )\n","\n","    except:\n","\n","        sentiment = \"UNKNOWN\"\n","\n","        confidence = 0\n","\n","\n","    # --------------------------------------------------------\n","    # CONVERT SENTIMENT\n","    # --------------------------------------------------------\n","\n","    if sentiment == \"POSITIVE\":\n","\n","        sentiment_icon = \"😊 POSITIVE\"\n","\n","    elif sentiment == \"NEGATIVE\":\n","\n","        sentiment_icon = \"😞 NEGATIVE\"\n","\n","    else:\n","\n","        sentiment_icon = \"😐 NEUTRAL\"\n","\n","\n","    # --------------------------------------------------------\n","    # FIND PRODUCT TOPICS\n","    # --------------------------------------------------------\n","\n","    topics = []\n","\n","    for topic, keywords in product_keywords.items():\n","\n","        for keyword in keywords:\n","\n","            if keyword in text:\n","\n","                topics.append(topic)\n","\n","                break\n","\n","    topics = list(dict.fromkeys(topics))\n","\n","\n","    # --------------------------------------------------------\n","    # WORD ANALYSIS\n","    # --------------------------------------------------------\n","\n","    words = re.findall(\n","        r'\\b[a-zA-Z]+\\b',\n","        text\n","    )\n","\n","    stop_words = {\n","        \"the\", \"is\", \"was\", \"a\", \"an\",\n","        \"and\", \"or\", \"to\", \"of\", \"in\",\n","        \"for\", \"it\", \"this\", \"that\",\n","        \"very\", \"with\", \"my\", \"i\",\n","        \"have\", \"has\", \"had\"\n","    }\n","\n","    useful_words = [\n","        word\n","        for word in words\n","        if word not in stop_words\n","    ]\n","\n","    frequency = Counter(useful_words)\n","\n","    common_words = frequency.most_common(5)\n","\n","\n","    # --------------------------------------------------------\n","    # POSITIVE / NEGATIVE KEYWORDS\n","    # --------------------------------------------------------\n","\n","    positive_words = [\n","        \"good\", \"great\", \"excellent\",\n","        \"amazing\", \"best\", \"perfect\",\n","        \"love\", \"nice\", \"awesome\",\n","        \"happy\", \"worth\", \"fast\",\n","        \"comfortable\", \"beautiful\"\n","    ]\n","\n","    negative_words = [\n","        \"bad\", \"poor\", \"worst\",\n","        \"terrible\", \"hate\", \"slow\",\n","        \"late\", \"broken\", \"damaged\",\n","        \"expensive\", \"waste\", \"disappointed\",\n","        \"problem\", \"defective\"\n","    ]\n","\n","    found_positive = [\n","        word for word in positive_words\n","        if word in text\n","    ]\n","\n","    found_negative = [\n","        word for word in negative_words\n","        if word in text\n","    ]\n","\n","\n","    # --------------------------------------------------------\n","    # REVIEW RATING\n","    # --------------------------------------------------------\n","\n","    if sentiment == \"POSITIVE\":\n","\n","        rating = \"⭐⭐⭐⭐⭐\"\n","\n","    elif sentiment == \"NEGATIVE\":\n","\n","        rating = \"⭐⭐\"\n","\n","    else:\n","\n","        rating = \"⭐⭐⭐\"\n","\n","\n","    # --------------------------------------------------------\n","    # BUSINESS INSIGHT\n","    # --------------------------------------------------------\n","\n","    if sentiment == \"POSITIVE\":\n","\n","        business_insight = \"\"\"\n","The customer appears satisfied with the product.\n","The business should continue maintaining product quality\n","and customer service.\n","\"\"\"\n","\n","    elif sentiment == \"NEGATIVE\":\n","\n","        business_insight = \"\"\"\n","The review indicates customer dissatisfaction.\n","The business should investigate the mentioned problems\n","and improve product or service quality.\n","\"\"\"\n","\n","    else:\n","\n","        business_insight = \"\"\"\n","The review contains mixed or neutral feedback.\n","The business should examine the specific topics mentioned\n","by the customer.\n","\"\"\"\n","\n","\n","    # --------------------------------------------------------\n","    # TOPIC OUTPUT\n","    # --------------------------------------------------------\n","\n","    if topics:\n","\n","        topic_text = \"\\n\".join(\n","            [f\"✓ {topic}\" for topic in topics]\n","        )\n","\n","    else:\n","\n","        topic_text = \"No specific product topics detected.\"\n","\n","\n","    # --------------------------------------------------------\n","    # COMMON WORD OUTPUT\n","    # --------------------------------------------------------\n","\n","    if common_words:\n","\n","        frequency_text = \"\\n\".join(\n","            [\n","                f\"- {word}: {count}\"\n","                for word, count in common_words\n","            ]\n","        )\n","\n","    else:\n","\n","        frequency_text = \"No frequent words found.\"\n","\n","\n","    # --------------------------------------------------------\n","    # POSITIVE WORD OUTPUT\n","    # --------------------------------------------------------\n","\n","    if found_positive:\n","\n","        positive_text = \", \".join(\n","            found_positive\n","        )\n","\n","    else:\n","\n","        positive_text = \"None\"\n","\n","\n","    # --------------------------------------------------------\n","    # NEGATIVE WORD OUTPUT\n","    # --------------------------------------------------------\n","\n","    if found_negative:\n","\n","        negative_text = \", \".join(\n","            found_negative\n","        )\n","\n","    else:\n","\n","        negative_text = \"None\"\n","\n","\n","    # --------------------------------------------------------\n","    # FINAL REPORT\n","    # --------------------------------------------------------\n","\n","    report = f\"\"\"\n","# 🛒 E-COMMERCE REVIEW ANALYZER\n","\n","---\n","\n","## 📝 Customer Review\n","\n","> {review}\n","\n","---\n","\n","## 😊 Sentiment Analysis\n","\n","### {sentiment_icon}\n","\n","**Confidence:** {confidence}%\n","\n","**Estimated Rating:** {rating}\n","\n","---\n","\n","## 🔍 Product Topics Detected\n","\n","{topic_text}\n","\n","---\n","\n","## 👍 Positive Keywords\n","\n","**{positive_text}**\n","\n","---\n","\n","## 👎 Negative Keywords\n","\n","**{negative_text}**\n","\n","---\n","\n","## 📊 Review Statistics\n","\n","**Total Words:** {len(words)}\n","\n","**Unique Words:** {len(set(words))}\n","\n","---\n","\n","## 🔤 Frequently Used Words\n","\n","{frequency_text}\n","\n","---\n","\n","## 💼 Business Insight\n","\n","{business_insight}\n","\n","---\n","\n","## 💡 Recommendations\n","\n","1. Monitor customer feedback regularly.\n","2. Improve areas receiving negative comments.\n","3. Maintain features customers appreciate.\n","4. Improve delivery and packaging when required.\n","5. Use customer reviews to improve product quality.\n","6. Track repeated complaints across multiple reviews.\n","\n","---\n","\n","### ⚠️ Note\n","\n","This application is an educational demonstration of\n","NLP-based e-commerce review analysis.\n","\"\"\"\n","\n","\n","    return report\n","\n","\n","# ============================================================\n","# MULTIPLE REVIEW ANALYSIS\n","# ============================================================\n","\n","def compare_reviews(reviews):\n","\n","    if reviews is None or reviews.strip() == \"\":\n","        return \"Please enter multiple reviews.\"\n","\n","    review_list = [\n","        r.strip()\n","        for r in reviews.split(\"\\n\")\n","        if r.strip()\n","    ]\n","\n","    positive = 0\n","    negative = 0\n","    neutral = 0\n","\n","    for review in review_list:\n","\n","        try:\n","\n","            result = sentiment_model(review)[0]\n","\n","            label = result[\"label\"]\n","\n","            if label == \"POSITIVE\":\n","\n","                positive += 1\n","\n","            elif label == \"NEGATIVE\":\n","\n","                negative += 1\n","\n","            else:\n","\n","                neutral += 1\n","\n","        except:\n","\n","            pass\n","\n","\n","    total = len(review_list)\n","\n","    report = f\"\"\"\n","# 📊 MULTIPLE REVIEW ANALYSIS\n","\n","**Total Reviews:** {total}\n","\n","### 😊 Positive Reviews\n","**{positive}**\n","\n","### 😞 Negative Reviews\n","**{negative}**\n","\n","### 😐 Neutral Reviews\n","**{neutral}**\n","\n","---\n","\n","## 📈 Overall Customer Feedback\n","\n","\"\"\"\n","\n","    if positive > negative:\n","\n","        report += \"\"\"\n","### 👍 Overall Feedback: POSITIVE\n","\n","Most customers appear satisfied with the product.\n","\"\"\"\n","\n","    elif negative > positive:\n","\n","        report += \"\"\"\n","### ⚠️ Overall Feedback: NEGATIVE\n","\n","Many customers appear dissatisfied.\n","The business should investigate common complaints.\n","\"\"\"\n","\n","    else:\n","\n","        report += \"\"\"\n","### 😐 Overall Feedback: MIXED\n","\n","Customer opinions are divided.\n","Further analysis is recommended.\n","\"\"\"\n","\n","\n","    return report\n","\n","\n","# ============================================================\n","# GRADIO WEB APPLICATION\n","# ============================================================\n","\n","with gr.Blocks(\n","    title=\"E-Commerce Review Analyzer\"\n",") as app:\n","\n","    gr.Markdown(\n","        \"\"\"\n","        # 🛒 E-Commerce Review Analyzer\n","\n","        ### AI-Based Product Review Analysis\n","\n","        Analyze customer reviews using **Natural Language Processing (NLP)**.\n","\n","        The application identifies:\n","\n","        ✅ Positive / Negative Sentiment\n","        ✅ Confidence Score\n","        ✅ Product Topics\n","        ✅ Positive Keywords\n","        ✅ Negative Keywords\n","        ✅ Common Words\n","        ✅ Business Insights\n","        \"\"\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # SINGLE REVIEW\n","    # --------------------------------------------------------\n","\n","    gr.Markdown(\n","        \"## 🔎 Analyze a Single Product Review\"\n","    )\n","\n","    review_input = gr.Textbox(\n","        label=\"Customer Review\",\n","        placeholder=(\n","            \"Example: The product quality is excellent \"\n","            \"and delivery was very fast. I really like it.\"\n","        ),\n","        lines=6\n","    )\n","\n","    analyze_button = gr.Button(\n","        \"🔍 Analyze Review\",\n","        variant=\"primary\"\n","    )\n","\n","    single_output = gr.Markdown()\n","\n","    analyze_button.click(\n","        fn=analyze_review,\n","        inputs=review_input,\n","        outputs=single_output\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # MULTIPLE REVIEWS\n","    # --------------------------------------------------------\n","\n","    gr.Markdown(\n","        \"---\"\n","    )\n","\n","    gr.Markdown(\n","        \"## 📊 Analyze Multiple Reviews\"\n","    )\n","\n","    multiple_reviews = gr.Textbox(\n","        label=\"Enter Multiple Reviews\",\n","        placeholder=(\n","            \"Enter one review per line.\\n\\n\"\n","            \"Example:\\n\"\n","            \"Amazing product and very good quality.\\n\"\n","            \"Delivery was late and packaging was poor.\\n\"\n","            \"The product is okay but the price is high.\"\n","        ),\n","        lines=10\n","    )\n","\n","    compare_button = gr.Button(\n","        \"📊 Analyze All Reviews\"\n","    )\n","\n","    multiple_output = gr.Markdown()\n","\n","    compare_button.click(\n","        fn=compare_reviews,\n","        inputs=multiple_reviews,\n","        outputs=multiple_output\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # FOOTER\n","    # --------------------------------------------------------\n","\n","    gr.Markdown(\n","        \"\"\"\n","        ---\n","\n","        ### 🛠️ Technologies Used\n","\n","        **Python | NLP | Transformers | Sentiment Analysis | Gradio**\n","\n","        **Project:** E-Commerce Review Analyzer\n","\n","        **Purpose:** Academic / Educational Project\n","        \"\"\"\n","    )\n","\n","\n","# ============================================================\n","# LAUNCH PUBLIC APPLICATION\n","# ============================================================\n","\n","app.launch(\n","    share=True,\n","    debug=True\n",")"],"metadata":{"id":"e8Ld5CiLQnb6","outputId":"5c06ab80-df10-4b74-8773-2678babba84a","colab":{"base_uri":"https://localhost:8080/","height":712,"referenced_widgets":["0c80182029134939bd69546b619dacbb","a833b63d832b4efc9e5023a76cd1e280","d7418c4ee0a44b37b79922870015341e","c9e0244621d944e3a5750a422434ac26","63f0d103aedd4659bc1b2a175261a3a7","c6c2e4f84865485d9b595477b14127aa","406ce122a49c43f1a59c3cc5b9495579","741ea762d41b4c6e8aa695788222f8e1","d320515cf75a46e0bf0b30b1e128425c","097bee76773b48ae835a9ac84615249d","7ea88ff3fb8546e29eb22271ccc1ad50"]},"executionInfo":{"status":"ok","timestamp":1788239585169,"user_tz":-330,"elapsed":988859,"user":{"displayName":"Katam Sanjana","userId":"18386676696181607639"}}},"execution_count":5,"outputs":[{"metadata":{"tags":null},"name":"stderr","output